# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173

# Set to true to serve the built React app from this same process.
SERVE_CLIENT=false
CLIENT_DIR=../gandhi-foundation-react/dist

# --- Email ---
# Leave SMTP_HOST empty to run without email: enquiries are still accepted and
# written to data/enquiries.json so nothing is lost.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gandhi Foundation <no-reply@gandhifoundation.org>
MAIL_TO=
